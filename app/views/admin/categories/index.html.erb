<% content_for :title, "Categories" %>

<div class="w-full">
  <% if notice.present? %>
    <p id="notice"
       class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block">
      <%= notice %>
    </p>
  <% end %>

  <div class="flex justify-between items-center mb-8">
    <h1 class="font-bold text-4xl">Categories</h1>

    <%= link_to "New category",
      new_category_path,
      class: "rounded-md px-4 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium" %>
  </div>

  <div class="overflow-x-auto shadow rounded-lg border border-gray-200">
    <% if @categories.any? %>
      <table class="min-w-full divide-y divide-gray-300">
        <thead class="bg-gray-100">
          <tr>
            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 border">
              Image
            </th>
            
            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 border">
              Name
            </th>
            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 border">
              Description
            </th>
            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700 border">
              Actions
            </th>
          </tr>
        </thead>

  <tbody class="divide-y divide-gray-200 bg-white">
    <% @categories.each do |category| %>
      <tr id="<%= dom_id(category) %>" class="hover:bg-gray-50 transition">
        <td class="px-4 py-3 border align-top">
          <%= category.image.present? ? image_tag(category.image.variant(:thumb)) : image_tag("https://placehold.co/50x50") %>
        </td>

        <td class="px-4 py-3 border align-top">
          <%= category.name %>
        </td>

           
              <td class="px-4 py-3 border align-top">
                <%= category.description %>
              </td>

         
              <td class="px-4 py-3 border">
                <div class="flex flex-col sm:flex-row gap-2">
                  <%= link_to "Show",
                        category,
                        class: "px-3 py-2 rounded-md bg-gray-100 hover:bg-gray-50 text-sm font-medium text-center" %>

                  <%= link_to "Edit",
                        edit_category_path(category),
                        class: "px-3 py-2 rounded-md bg-gray-100 hover:bg-gray-50 text-sm font-medium text-center" %>

                  <%= button_to "Destroy",
                        category,
                        method: :delete,
                        data: { turbo_confirm: "Are you sure?" },
                        class: "px-3 py-2 rounded-md bg-red-600 hover:bg-red-500 text-white text-sm font-medium text-center cursor-pointer" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-center py-10">No categories found.</p>
    <% end %>
  </div>
</div>

